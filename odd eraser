#include<iostream>
#include<vector>

using namespace std;
int hcf(int a,int b){
	return (b==0)?a:hcf(a,a%b);
	
}
void solve(){
	int N;
	cin>>N;
	vector <int> arr(N);
	for(int i=0;i<N;i++){
		cin>>arr[i];
	}
	cout<<hcf(arr[0],arr[N-1]);
}
int main(){
	ios::sync_with_stdio(false);
	cin.tie(0);
	int n;
	cin>>n;
	while(n--){
		solve();
	}
}
