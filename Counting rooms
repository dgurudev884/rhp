#include <bits/stdc++.h>
using namespace std;

int n, m;
vector<string> grid;
vector<vector<bool>> vis;

int dx[] = {1, -1, 0, 0};
int dy[] = {0, 0, 1, -1};

void dfs(int x, int y) {
    vis[x][y] = true;

    for (int k = 0; k < 4; k++) {
        int nx = x + dx[k];
        int ny = y + dy[k];

        if (nx < 0 || nx >= n || ny < 0 || ny >= m)
            continue;

        if (grid[nx][ny] == '#' || vis[nx][ny])
            continue;

        dfs(nx, ny);
    }
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    cin >> n >> m;

    grid.resize(n);
    vis.assign(n, vector<bool>(m, false));

    for (auto &row : grid)
        cin >> row;

    int rooms = 0;

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {

            // Start a new DFS for every unvisited empty cell
            if (grid[i][j] == '.' && !vis[i][j]) {
                rooms++;
                dfs(i, j);
            }
        }
    }

    cout << rooms << '\n';

    return 0;
}
