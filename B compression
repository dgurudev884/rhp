import java.util.*;
class Main{
  public static void main(String[] args){
    Scanner sc=new Scanner(System.in);
    int a=sc.nextInt();
    TreeSet<Integer> se=new TreeSet<>();
    for(int i=1;i<=a;i++){
      int x=sc.nextInt();
      se.add(x);
    }
    System.out.println(se.size());
    for(int k:se){
      System.out.print(k+" ");
    }
    System.out.println();
  }
}
