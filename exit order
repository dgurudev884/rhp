#include<iostream>
using namespace std;
void solve(){
	int n;
	cin>>n;
	int st=1,end=10;
	for(int i=1;i<n+1;i++){
		int c;
		cin>>c;
		if(!(c>=st && c<=end)){
			cout<<"No"<<endl;
			return;}
		if(i%10==0){
			st=st+10;
			end=end+10;
		}
	}
	cout<<"Yes"<<endl;
}
int main(){
  ios::sync_with_stdio(null);
  cin.tie(0);
	solve();
}
