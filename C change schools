#include<iostream>
#include<queue>
#include<vector>
#include<algorithm>
#include<map>
using namespace std;
void solve(){
	int n,k;
    cin >> n >> k;
    vector<int> cnt(k + 1, 0);

    for (int i = 0; i < n; i++) {
        int x;cin >> x;
        cnt[x]++;
    }

    int m = 0;
    for (int r = 1; r <= k; r++)
        m = max(m, cnt[r]);

    int ans = 0;

    for (int i = 1; i <= k; i++) 
        if (cnt[i] >= m - 1) 
            ans++;
    cout << ans << '\n';
}
int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    solve();
}
