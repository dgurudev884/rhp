import java.util.*;
class Main{
  public static void main(String[] args){
    Scanner sc=new Scanner(System.in);
    int a=sc.nextInt();
    int b=sc.nextInt();
    int[] ar=new int[a+2];
    for(int j=1;j<=b;j++){
      int l=sc.nextInt();
      int r=sc.nextInt();
      ar[l]++;
      ar[r+1]--;
    }
    int mi=200005;
    for(int k=1;k<=a;k++){
      ar[k]+=ar[k-1];
      mi=Math.min(mi,ar[k]);
    }
    System.out.println(mi);
  }
}
