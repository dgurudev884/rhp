import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] a = new int[n + 1];

        for (int i = 1; i <= n; i++) {
            a[i] = sc.nextInt();
        }

        int sa = 0, ex = 0;

        for (int i = 1; i <= n; i++) {
            if (i == a[i]) {
                sa++;
            } else if (i == a[a[i]]) {
                ex++;
            }
        }

        System.out.println(ex / 2 + 1L * sa * (sa - 1) / 2);
    }
}
