import java.util.*;
class citybfs{
	public static void main(String[] args){
		int r;
		Scanner sc=new Scanner(System.in);
		r=sc.nextInt();
		HashMap<Integer,List<int[]>> g=new HashMap<>();
		while(r-->0){
			int src=sc.nextInt(),des=sc.nextInt(),dist=sc.nextInt();
			if(!g.containsKey(src)){
				g.put(src,new ArrayList<>());};
				g.get(src).add(new int[]{des,dist});
			if(!g.containsKey(des)){
				g.put(des,new ArrayList<>());};
				g.get(des).add(new int[]{src,dist});
		}
		int st=sc.nextInt(),end=sc.nextInt();
		Set<Integer> visit=new HashSet<>();
		PriorityQueue<int[]> pq=new PriorityQueue<>((a,b)->{return a[1]-b[1];});
		pq.add(new int[]{st,0});
		while(!pq.isEmpty()){
			int[] cur=pq.poll();
			int currcity=cur[0],curdist=cur[1];
			if(currcity==end){
				System.out.println(curdist);
				return;
			}
			if(visit.contains(currcity)){
				continue;
			}
			visit.add(currcity);
			if(g.containsKey(currcity)){
				for(int[] ocarray:g.get(currcity)){
					int oc=ocarray[0],ocd=ocarray[1];
					if(!visit.contains(oc)){
						pq.add(new int[]{oc,ocd+curdist});
					}
				}
			}
		}
	}
}
