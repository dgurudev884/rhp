#include<iostream>
#include<vector>
#include<algorithm>
#include<set>
#include<map>
#include<queue>
using namespace std;
int main(){
    int n;
    cin>>n;
    int odd=0,eod=0,eev=0;
    vector<int> x(n);
    for(int i=0;i<n;i++){
        cin>>x[i];
    }
    for(int i =0;i<n;i++){
        if(x[i]%2!=0){
            odd++;
        }
        else if((x[i]/2)%2!=0){
            eod++;
        }
        else{
            eev++;
        }
    }
    cout<<max({odd,eod,eev})<<endl;
}
