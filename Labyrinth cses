#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    cin >> n >> m;

    vector<string> grid(n);
    for (auto &row : grid) cin >> row;

    queue<pair<int, int>> q;
    vector<vector<bool>> vis(n, vector<bool>(m, false));
    vector<vector<char>> parent(n, vector<char>(m, 0));

    int sx, sy, ex, ey;

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            if (grid[i][j] == 'A') {
                sx = i;
                sy = j;
            }
            if (grid[i][j] == 'B') {
                ex = i;
                ey = j;
            }
        }
    }

    // D, U, R, L
    int dx[] = {1, -1, 0, 0};
    int dy[] = {0, 0, 1, -1};
    char dir[] = {'D', 'U', 'R', 'L'};

    q.push({sx, sy});
    vis[sx][sy] = true;

    while (!q.empty()) {
        auto [x, y] = q.front();
        q.pop();

        for (int k = 0; k < 4; k++) {
            int nx = x + dx[k];
            int ny = y + dy[k];

            if (nx < 0 || nx >= n || ny < 0 || ny >= m)
                continue;

            if (grid[nx][ny] == '#' || vis[nx][ny])
                continue;

            vis[nx][ny] = true;
            parent[nx][ny] = dir[k];
            q.push({nx, ny});
        }
    }

    if (!vis[ex][ey]) {
        cout << "NO\n";
        return 0;
    }

    string path;
    int x = ex, y = ey;

    while (x != sx || y != sy) {
        char d = parent[x][y];
        path += d;

        if (d == 'D') x--;
        else if (d == 'U') x++;
        else if (d == 'R') y--;
        else if (d == 'L') y++;
    }

    reverse(path.begin(), path.end());

    cout << "YES\n";
    cout << path.size() << '\n';
    cout << path << '\n';

    return 0;
}
